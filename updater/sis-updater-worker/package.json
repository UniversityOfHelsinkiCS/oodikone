{
  "name": "sis-updater-worker",
  "private": true,
  "scripts": {
    "build": "tsc && npm run copy:csv",
    "copy:csv": "cp src/updater/updateStudents/excludedPartialAttainments.csv dist/src/updater/updateStudents/",
    "start": "node ./dist/src/index.js",
    "dev": "nodemon --exec \"node --import tsx ./src/index.ts\" --ext ts,js,json --watch src",
    "test": "vitest run",
    "test:unit": "vitest run ./tests/unit",
    "test:watch": "vitest"
  },
  "dependencies": {
    "async": "^3.2.6",
    "bullmq": "^5.53.2",
    "knex": "^3.3.0",
    "lodash-es": "^4.17.23",
    "pg": "^8.20.0",
    "redis": "^4.7.1",
    "redis-lock": "^1.0.0",
    "sequelize": "^6.37.8",
    "umzug": "^3.8.3",
    "winston": "^3.19.0",
    "winston-loki": "^6.1.5",
    "winston-transport-sentry-node": "^3.0.0"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.18.0",
    "nodemon": "3.1.14",
    "tsx": "^4.19.4",
    "typescript": "^7.0.2",
    "vitest": "4.1.9"
  }
}
